[ext_resource type="Texture2D" uid="uid://dtn7a3i8jojbf" path="res://Assets/vignette.png" id="1"]

[sub_resource type="Shader" id="1"]
code = "shader_type canvas_item;

uniform sampler2D vignette;
uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;

void fragment() {
	vec3 vignette_color = texture(vignette,UV).rgb;
	//screen texture stores gaussian blurred copies on mipmaps
	COLOR.rgb = textureLod(SCREEN_TEXTURE,SCREEN_UV,(1.0-vignette_color.r)).rgb;
	COLOR.rgb*= texture(vignette,UV).rgb * vec3(0.75, 0.75, 0.75);
}"

[sub_resource type="ShaderMaterial" id="2"]
shader = SubResource("1")
shader_parameter/vignette = ExtResource("1")

